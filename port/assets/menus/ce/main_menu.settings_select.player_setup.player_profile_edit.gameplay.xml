	<strings name="main_menu/settings_select/player_setup/player_profile_edit/gameplay/help_strings">
		<string text=""/>
		<string text="The game's messages at the bottom left: never,\nin the menus only, or in games too."/>
		<string text="Default: finish a level to unlock the next.\nAll unlocked: every campaign level can be played."/>
		<string text="How the bodies of players and the AI fall."/>
		<string text="The view over your shoulder on foot, which\nsides and how far back."/>
		<string text="The randomizer: a campaign level's enemies\nand weapons swapped."/>
		<string text="The Master Chief Collection's skulls, and\nhow they are found."/>
		<string text="The campaign's score, its time and par times,\nand medals, in multiplayer too."/>
		<string text="Online leaderboards, the daily challenge, and\nthe community server."/>
		<string text="Weapons and AI of Custom Edition maps, in\nprofiles the randomizer can add."/>
		<string text="Where Custom Edition maps are read from and\ndownloaded to. A chooses another folder."/>
	</strings>
